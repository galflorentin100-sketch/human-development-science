# HDS runtime
COMPANY_OS_ENV=development
COMPANY_OS_DB=company_os.db
COMPANY_OS_LOG_LEVEL=INFO

# Model provider: local (safe default) or anthropic
HDS_MODEL_PROVIDER=local
ANTHROPIC_API_KEY=
HDS_ANTHROPIC_MODEL=claude-sonnet-5

# Required before enabling external spend.
# Values are USD per 1,000,000 tokens.
HDS_INPUT_COST_PER_MILLION_TOKENS=0
HDS_OUTPUT_COST_PER_MILLION_TOKENS=0

# Production must use PostgreSQL.
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
